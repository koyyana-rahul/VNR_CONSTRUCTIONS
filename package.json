{
  "name": "vnr-constructions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-images.mjs && node scripts/generate-sitemap.mjs && vite build",
    "preview": "vite preview --port 5199",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:company": "node scripts/check-company-data.mjs",
    "fix:imports": "node scripts/fix-imports.mjs",
    "images": "node scripts/generate-images.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "verify": "npm run lint && npm run test && npm run build",
    "verify:glass": "node scripts/verify-glass.mjs",
    "capture": "node scripts/capture.mjs",
    "verify:all": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "undici": "7.16.0"
  }
}
